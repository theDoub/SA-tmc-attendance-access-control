# Copy to .env for local development. All values are DUMMY. Never commit a real .env.
# Source tags: [A1] = value stated in Assignment 1; [proposed] = scaffold default; [OD-nn] = open decision.

# --- Edge identity (dummy) ---
TMC_EDGE_ID=edge-dev-001
TMC_STATION_ID=station-dev-001
TMC_FACTORY_ID=factory-dev

# --- Local persistence [A1 ADR-003: SQLite WAL, file-backed] ---
TMC_SQLITE_PATH=data/edge.db

# --- Hub endpoint (placeholder, not a real host) [OD-10: transport auth undecided] ---
TMC_HUB_BASE_URL=https://hub.example.invalid

# --- QR verification: PUBLIC keys only. Never put private keys here. [OD-01] ---
TMC_QR_PUBLIC_KEY_DIR=keys/public
# Intentionally unset: A1 gives no value (OD-02/OD-08). Uncomment once the team decides.
# TMC_QR_CLOCK_SKEW_SECONDS=

# --- Cache / offline policy [A1 Table 28] ---
TMC_CACHE_FRESH_SECONDS=300
TMC_CACHE_MAX_STALE_SECONDS=7200
TMC_CENTRAL_AUTH_TIMEOUT_MS=500

# --- Gate [A1 Table 29, 4.2.3] ---
TMC_TURNSTILE_TIMEOUT_MS=800
TMC_PASSAGE_WINDOW_SECONDS=15
# vendor | mock  (vendor adapter is a stub: vendor API is not specified, OD-13)
TMC_TURNSTILE_MODE=mock
# Required when mode=mock. One of: acked_with_passage, acked_no_passage,
# acked_passage_unavailable, rejected, timeout, unavailable
TMC_TURNSTILE_MOCK_SCENARIO=acked_with_passage

# --- Store-and-forward retry [A1 4.3.5] (JSON list for the tuple) ---
TMC_SYNC_BACKOFF_DELAYS_SECONDS=[5,10,20,40,60]
TMC_SYNC_BACKOFF_JITTER_MIN=0.8
TMC_SYNC_BACKOFF_JITTER_MAX=1.0
